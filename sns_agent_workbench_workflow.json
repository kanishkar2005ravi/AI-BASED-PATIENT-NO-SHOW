    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO patients (id, name, email, password, phone, date_of_birth, gender, address) VALUES ('{{json.body.data.patientId}}', '{{json.body.data.name}}', '{{json.body.data.email}}', '{{json.body.data.password}}', '{{json.body.data.phone}}', CAST('{{json.body.data.dateOfBirth}}' AS DATE), '{{json.body.data.gender}}', '{{json.body.data.address}}') ON CONFLICT (id) DO UPDATE SET name = EXCLUDED.name, email = EXCLUDED.email, password = EXCLUDED.password RETURNING *;"
      },
      "id": "query-create-patient",
      "name": "Execute Query: CREATE_PATIENT",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [580, 250]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO appointments (id, patient_id, doctor_id, appointment_date, appointment_time, appointment_type, status, no_show_risk_score, no_show_risk_level) VALUES (CONCAT('APT-', CAST(EXTRACT(EPOCH FROM NOW()) AS BIGINT)), '{{json.body.patient_id}}', '{{json.body.doctor_id}}', CAST('{{json.body.appointment_date}}' AS DATE), '{{json.body.appointment_time}}', '{{json.body.reason}}', 'SCHEDULED', 20, 'LOW') RETURNING *;"
      },
      "id": "query-book-appointment",
      "name": "Execute Query: BOOK_APPOINTMENT",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [580, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM patients ORDER BY created_at DESC;"
      },
      "id": "query-get-patients",
      "name": "Execute Query: GET_PATIENTS",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [580, 550]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.patient_id AS \"patientId\", p.name AS \"patientName\", p.email AS \"patientEmail\", a.doctor_id AS \"doctorId\", d.name AS \"doctorName\", d.specialization AS \"doctorSpecialization\", a.appointment_date AS \"appointmentDate\", a.appointment_time AS \"appointmentTime\", a.appointment_type AS \"appointmentType\", a.status FROM appointments a LEFT JOIN patients p ON a.patient_id = p.id LEFT JOIN doctors d ON a.doctor_id = d.id ORDER BY a.appointment_date DESC;"
      },
      "id": "query-get-appointments",
      "name": "Execute Query: GET_APPOINTMENTS",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [580, 700]
